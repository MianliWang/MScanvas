{
  "name": "mscanvas-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "A modern open-source workspace for mass spectrometry data.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": "11.15.1"
  },
  "scripts": {
    "dev": "pnpm --filter @mscanvas/desktop dev",
    "tauri": "pnpm --filter @mscanvas/desktop tauri",
    "build": "pnpm --filter @mscanvas/desktop build",
    "lint": "pnpm --filter @mscanvas/desktop lint",
    "typecheck": "pnpm --filter @mscanvas/desktop typecheck",
    "test": "pnpm --filter @mscanvas/desktop test",
    "check:repo": "python scripts/check_repo.py",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:repo",
    "e2e:browser": "wdio run ./e2e/wdio.browser.conf.ts",
    "qa:m4.1": "pnpm e2e:typecheck && pnpm e2e:browser",
    "e2e:typecheck": "tsc -p ./e2e/tsconfig.json --noEmit",
    "e2e:build": "pnpm build && cargo build --release --features e2e,custom-protocol --bin mscanvas-desktop --target-dir target/e2e",
    "e2e:tauri": "wdio run ./e2e/wdio.tauri.conf.ts",
    "e2e:native-save": "wdio run ./e2e/wdio.tauri.conf.ts --spec ./e2e/specs/m4.2-native-save.native.e2e.ts",
    "e2e:native-dialog": "powershell -NoProfile -ExecutionPolicy Bypass -File ./e2e/native/probe-save-dialog.ps1",
    "qa:m4.2": "pnpm e2e:typecheck && pnpm e2e:browser && pnpm e2e:tauri && pnpm e2e:native-dialog"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MianliWang/MScanvas.git"
  },
  "homepage": "https://github.com/MianliWang/MScanvas#readme",
  "bugs": {
    "url": "https://github.com/MianliWang/MScanvas/issues"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "@wdio/cli": "^9.31.1",
    "@wdio/globals": "^9.31.1",
    "@wdio/local-runner": "^9.31.1",
    "@wdio/mocha-framework": "^9.31.1",
    "@wdio/spec-reporter": "^9.31.1",
    "@wdio/tauri-service": "^1.3.0",
    "@wdio/types": "^9.31.1",
    "expect-webdriverio": "^6.0.5",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
