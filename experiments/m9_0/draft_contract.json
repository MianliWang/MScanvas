{
 "status": "M9.0 draft for M9.1. Experiment-area examples only: not a production DTO, and schema 3 is unchanged. Field names are proposals; the logical model is what M9.1 must keep.",
 "recipe_definition": {
  "recipeId": "targetedMs1",
  "recipeVersion": 1,
  "purpose": "Target-specific MS1 signal and candidate detection for [M+H]+ ions; not identification and not a validated quantitative assay",
  "engine": {
   "package": "pyopenms",
   "version": "3.5.0",
   "algorithm": "FeatureFinderAlgorithmMetaboIdent",
   "upstreamMaturity": "experimental"
  },
  "adapterDigest": "sha256 of the reviewed worker script shipped with the application",
  "engineProfileDigest": "sha256 of the canonical fixed engine profile below",
  "fixedEngineProfile": {
   "extract:n_isotopes": 2,
   "extract:isotope_pmin": 0.0,
   "extract:im_window": 0.0,
   "detect:min_peak_width": 0.2,
   "detect:signal_to_noise": 0.8,
   "model:type": "symmetric",
   "model:no_imputation": "false",
   "EMGScoring:max_iteration": 100,
   "EMGScoring:init_mom": "true",
   "mappedFromPlan": {
    "extract:mz_window": "2 * mzHalfWidthPpm",
    "extract:rt_window": "2 * max(rtHalfWidthS)",
    "detect:peak_width": "expectedPeakWidthS",
    "candidates_out": "attempt staging file"
   }
  },
  "parameters": {
   "mzHalfWidthPpm": {
    "type": "number",
    "unit": "ppm",
    "meaning": "half-width of an open m/z interval",
    "min": 0.5,
    "max": 50
   },
   "expectedPeakWidthS": {
    "type": "number",
    "unit": "s",
    "minExclusive": 0,
    "max": 600
   }
  },
  "target": {
   "targetId": "UUID minted by the application; also the name the engine sees, so no user text reaches it",
   "label": "user text, kept in the project only",
   "formula": "plain neutral sum formula, required (isotope model)",
   "neutralMonoisotopicMass": "optional number > 0; when given, the ion m/z uses it",
   "charge": "exactly 1; the ion is [M+H]+",
   "rtS": "expected retention time, seconds",
   "rtHalfWidthS": "number > 0; the RT window is the closed interval [rtS - h, rtS + h]"
  },
  "domain": {
   "admitted": [
    "mzML with an unprefixed namespace, read in full (independent spectrum count equals the reader's)",
    "MS1 spectra declared centroid",
    "positive polarity only",
    "MS1 retention times declared, finite, >= 0 and strictly increasing across the file",
    "no ion mobility, FAIMS or extra arrays",
    "ASCII-only paths for the source as presented to the reader, the runtime and the work root"
   ],
   "refusedBeforeAnyRun": [
    "request or parameter outside the schema",
    "duplicate targetId",
    "charge other than 1",
    "a zero or negative RT half-width",
    "an m/z half-width below 0.5 ppm (the engine would read it as Da)"
   ],
   "failedRunWithRefusalCode": [
    "SOURCE_NOT_CENTROID",
    "SOURCE_MIXED_POLARITY",
    "SOURCE_POLARITY_UNSUPPORTED",
    "SOURCE_NO_MS1",
    "SOURCE_RT_UNDECLARED_OR_NONMONOTONIC",
    "SOURCE_RT_NOT_STRICTLY_INCREASING",
    "SOURCE_ION_MOBILITY_UNSUPPORTED",
    "SOURCE_CHANGED",
    "SOURCE_CHANGED_DURING_READ"
   ],
   "failedRun": [
    "SOURCE_UNREADABLE",
    "SOURCE_READ_INCOMPLETE",
    "ENGINE_NO_CANDIDATES",
    "ENGINE_ERROR",
    "EVIDENCE_MAPPING_MISMATCH"
   ]
  },
  "outcomes": [
   "DETECTED",
   "DETECTED_AMBIGUOUS",
   "SHARED",
   "SUPPRESSED_BY_OVERLAP",
   "NOT_DETECTED",
   "FAILED"
  ],
  "failedRowReasons": [
   "EXTRACTION_AT_SPECTRUM_EDGE",
   "CANDIDATES_WITHOUT_FEATURE",
   "ENGINE_DISCARDED_NO_VALID_FIT (read from source, not exercised)",
   "TARGET_ABSENT_FROM_ENGINE_LIBRARY"
  ]
 },
