root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.rs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.ps1]
end_of_line = crlf

# A byte-exact provider capture; see .gitattributes.
[docs/spikes/evidence/msconvert-3.0.26013-help.txt]
end_of_line = crlf
trim_trailing_whitespace = false
