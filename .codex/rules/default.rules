# MSCanvas project command policy.
# Experimental Codex exec-policy rules complement, but do not replace, CI and review.

prefix_rule(
    pattern = ["git", ["status", "diff", "log", "show", "branch", "remote"]],
    decision = "allow",
    justification = "Read-only repository inspection is safe.",
    match = ["git status -sb", "git diff --stat", "git log -5", "git branch --show-current", "git remote -v"],
)

prefix_rule(
    pattern = ["cargo", ["fmt", "check", "clippy", "test", "metadata"]],
    decision = "allow",
    justification = "Rust formatting, checks, tests, and metadata are approved quality gates.",
    match = ["cargo fmt --all --check", "cargo clippy --workspace", "cargo test --workspace", "cargo metadata --no-deps"],
)

prefix_rule(
    pattern = ["pnpm", ["lint", "typecheck", "test", "build", "check"]],
    decision = "allow",
    justification = "Checked-in frontend and repository quality scripts are approved gates.",
    match = ["pnpm lint", "pnpm typecheck", "pnpm test", "pnpm build", "pnpm check"],
)

prefix_rule(
    pattern = ["python", "scripts/check_repo.py"],
    decision = "allow",
    justification = "The repository-owned structural validator is read-only apart from normal interpreter caches.",
    match = ["python scripts/check_repo.py"],
)

prefix_rule(
    pattern = ["pnpm", "exec", "playwright"],
    decision = "allow",
    justification = "Playwright is an approved rendered UI test path once configured.",
    match = ["pnpm exec playwright test", "pnpm exec playwright test workspace.spec.ts"],
)

prefix_rule(
    pattern = ["cargo", ["add", "remove", "update", "install"]],
    decision = "prompt",
    justification = "Dependency and tool changes require explicit review.",
    match = ["cargo add serde", "cargo update", "cargo install cargo-audit"],
)

prefix_rule(
    pattern = ["pnpm", ["add", "remove", "update", "install"]],
    decision = "prompt",
    justification = "Dependency installation or mutation requires explicit review.",
    match = ["pnpm install", "pnpm add react", "pnpm update"],
)

prefix_rule(
    pattern = ["git", ["add", "commit", "push", "tag", "merge", "rebase", "cherry-pick"]],
    decision = "prompt",
    justification = "Repository mutations and remote writes require explicit approval.",
    match = ["git add .", "git commit -m change", "git push", "git tag v0.1.0"],
)

prefix_rule(
    pattern = ["gh", ["repo", "pr", "issue", "release"]],
    decision = "prompt",
    justification = "GitHub writes and repository administration require explicit review.",
    match = ["gh repo create", "gh pr create", "gh issue create", "gh release create"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Hard reset can destroy user work; use targeted reviewed restoration instead.",
    match = ["git reset --hard", "git reset --hard HEAD~1"],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "git clean can delete untracked user files.",
    match = ["git clean -fd", "git clean -fdx"],
)

prefix_rule(
    pattern = ["rm", ["-rf", "-fr"]],
    decision = "forbidden",
    justification = "Recursive forced deletion is unsafe in an agent workflow.",
    match = ["rm -rf target", "rm -fr node_modules"],
)

prefix_rule(
    pattern = ["cargo", "publish"],
    decision = "forbidden",
    justification = "Publishing crates is a release-owner action.",
    match = ["cargo publish", "cargo publish --dry-run"],
)

prefix_rule(
    pattern = ["pnpm", "publish"],
    decision = "forbidden",
    justification = "Publishing packages is a release-owner action.",
    match = ["pnpm publish", "pnpm publish --access public"],
)
